# Production / Vercel Production example
# Use production credentials only in Vercel or a private local file.

NEXT_PUBLIC_APP_URL=https://www.example.com
JWT_SECRET=production-long-random-secret
CRON_SECRET=production-long-random-secret

NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
