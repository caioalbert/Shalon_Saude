# Local development example
# Use sandbox/non-production credentials only.

NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=local-long-random-secret
CRON_SECRET=local-long-random-secret

NEXT_PUBLIC_SUPABASE_URL=https://your-dev-or-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-or-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-or-staging-service-role-key

BLOB_READ_WRITE_TOKEN=your-dev-blob-token

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=your-asaas-sandbox-key
ASAAS_WEBHOOK_TOKEN=your-asaas-sandbox-webhook-token



# MaisEdu - Cadastro de Parceiros
MAISEDU_API_TOKEN=your-maisedu-api-token
# Optional. Leave empty to omit "ref" from the partner request.
MAISEDU_REF_LOGIN=
